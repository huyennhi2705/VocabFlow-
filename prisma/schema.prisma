generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  decks        Deck[]
  sessions     Session[]
  quizAttempts QuizAttempt[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Deck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  words       Word[]
  quizAttempts QuizAttempt[]

  @@unique([userId, name])
  @@index([userId])
}

model Word {
  id          String   @id @default(cuid())
  deckId      String
  term        String
  normalizedTerm String
  meaning     String
  example     String   @default("")
  isRemembered Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, normalizedTerm])
  @@index([deckId])
  @@index([createdAt])
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  deckId         String?
  questionsJson  String
  answersJson    String    @default("[]")
  totalQuestions Int
  correctAnswers Int       @default(0)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck           Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
